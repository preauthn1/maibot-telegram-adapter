{
  "manifest_version": 2,
  "version": "0.2.0",
  "name": "Telegram 真人账号适配器",
  "description": "使用 MTProto (Telethon) 以真人 Telegram 账号身份收发消息，让麦麦看起来就是一个普通用户而不是 Bot",
  "author": {
    "name": "preauthn1",
    "url": "https://github.com/preauthn1"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/preauthn1/MaiBot",
    "homepage": "https://github.com/preauthn1/MaiBot",
    "issues": "https://github.com/preauthn1/MaiBot/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.9.9"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "telethon",
      "version_spec": ">=1.36.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "preauthn1.telegram-user-adapter"
}
