{
  "manifest_version": 2,
  "version": "0.3.0",
  "name": "Telegram 真人账号适配器",
  "description": "使用 MTProto (Telethon) 以个人 Telegram 账号收发消息的自动账号适配器；被认真问到身份时如实说明，不伪装为人工操作者",
  "author": {
    "name": "preauthn1",
    "url": "https://github.com/preauthn1"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/preauthn1/MaiBot",
    "homepage": "https://github.com/preauthn1/MaiBot",
    "issues": "https://github.com/preauthn1/MaiBot/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.9.9"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "telethon",
      "version_spec": ">=1.36.0"
    },
    {
      "type": "python_package",
      "name": "python-socks",
      "version_spec": ">=2.0.0"
    },
    {
      "type": "python_package",
      "name": "markdown-it-py",
      "version_spec": ">=4.0.0,<5"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.12.14,<4"
    }
  ],
  "capabilities": [
    "maisaka.context.append",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "frequency.set_adjust",
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "preauthn1.telegram-user-adapter"
}
